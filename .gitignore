# Dependencies
node_modules/

# Env
.env
.env.local
.env.*.local
.env.production
.env.development

# Build output
dist/
build/
combined-web-deploy/

# Prisma
apps/api/prisma/migrations/dev.db

# Expo / React Native
apps/*/.expo/
apps/*/.expo-shared/
# Managed workflow — native projects are generated fresh by `expo prebuild`
# / EAS Build each time, never committed. (4 Sep 2026 — added after running
# a local prebuild to verify a splash-screen fix; see that commit.)
apps/*/android/
apps/*/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Logs
npm-debug.log*
*.log

# TypeScript build cache
*.tsbuildinfo

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Scratch/staging artifacts from iterative development — never real source.
# See _to_delete/ itself for contents; kept out of git rather than deleted
# so nothing is lost, but none of it belongs in repo history.
_to_delete/

# Generated review page for the 4 Sep 2026 seed content pass. ~1MB, because
# every catalog image is inlined as a base64 data URI (the viewer it is
# published to admits no external image hosts). It is a published artifact,
# not source, and regenerating it would add another megabyte of blob to the
# history each time — so it is deliberately not tracked.
reports/seed-catalog.html
