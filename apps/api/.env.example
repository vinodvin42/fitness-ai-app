# Copy to .env and fill in for local development.

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_ai_app?schema=public"

PORT=4000
NODE_ENV=development

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-dev-only"
JWT_REFRESH_SECRET="replace-me-dev-only-different-from-access"
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed origins for CORS (mobile dev client, admin web later)
CORS_ORIGINS="http://localhost:19006,http://localhost:8081,http://localhost:5173"

# Admin console (Phase 6, 20 Aug 2026) — a separate secret from
# JWT_ACCESS_SECRET so admin and consumer session tokens can never be
# confused. Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET="replace-me-dev-only-different-from-jwt-access-and-refresh"
ADMIN_JWT_ACCESS_TTL_MIN=480

# Coach marketplace (Phase 5, 20 Aug 2026) — another separate secret, for
# Professional (apps/coach-mobile) sessions. Generate with: openssl rand -base64 48
PROFESSIONAL_JWT_SECRET="replace-me-dev-only-different-from-every-other-jwt-secret"
PROFESSIONAL_JWT_ACCESS_TTL_MIN=15
PROFESSIONAL_JWT_REFRESH_TTL_DAYS=30

# Gym Partner Lite portal (apps/gym-portal, R2 Wave 5, 21 Sep 2026) — yet
# another separate secret, same "never interchangeable" reasoning as
# ADMIN_JWT_SECRET/PROFESSIONAL_JWT_SECRET above. No refresh-token flow
# (see config/env.ts's own comment on this var). Generate with:
# openssl rand -base64 48
GYM_JWT_SECRET="replace-me-dev-only-different-from-every-other-jwt-secret"
GYM_JWT_ACCESS_TTL_MIN=480

# Creator Portal (R2 Wave 5, 21 Sep 2026) — an Influencer's own
# self-service login (apps/creator-portal). Generate with: openssl rand -base64 48
INFLUENCER_JWT_SECRET="replace-me-dev-only-different-from-every-other-jwt-secret"
INFLUENCER_JWT_ACCESS_TTL_MIN=15
INFLUENCER_JWT_REFRESH_TTL_DAYS=30

# Two-Factor Authentication (25 Aug 2026, Phase 4, gap §17) — encrypts
# User.twoFactorSecret at rest. Unlike the JWT secrets above, this must be
# EXACTLY 64 hex chars (32 raw bytes — AES-256-GCM's fixed key size), so a
# loose "replace-me-dev-only" placeholder won't pass validation the way it
# does for those. The value below was generated for you with
# `openssl rand -hex 32` so local dev boots immediately — generate your
# OWN with that same command before deploying anywhere real; never reuse
# this published value outside local dev.
TWO_FACTOR_ENCRYPTION_KEY="e4cd81e815a12beab85187cf304ae14428600f6f885840fec809507e6a65b2c3"

# Razorpay (20 Aug 2026, gap §14) — leave blank to run with payments
# unconfigured; every payment route then returns a clear 503 instead of
# crashing. Get real test-mode keys from https://dashboard.razorpay.com
# (Settings -> API Keys) and a webhook secret from Settings -> Webhooks
# when you add the endpoint URL there (POST <your-api-url>/payments/razorpay/webhook).
# NOTE: this app's seeded prices are USD-labeled cents — see
# docs/mobile/07-open-questions-gaps.md for why RAZORPAY_CURRENCY=INR
# needs real INR list prices before this should process a real charge.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Go-live hardening (25 Aug 2026) — a live Razorpay key (rzp_live_...)
# will not boot unless this is "true". See config/env.ts's own comment —
# the currency mismatch above must actually be resolved first (real INR
# list prices, or a USD-settling account), not just acknowledged. Test
# keys (rzp_test_...) are unaffected either way.
PRICE_CURRENCY_CONFIRMED=false

# AI provider config — see apps/api/src/lib/aiClient.ts. AI_PROVIDER picks
# which of the three blocks below is used; leave the matching key(s) blank
# to run with AI Coach unconfigured (GET /ai/status will report
# configured:false, and POST /ai-coach/messages returns a real 503 rather
# than a fake reply).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Azure OpenAI (AI_PROVIDER=azure-openai). All three required together —
# the app refuses to boot if only some are set. AZURE_OPENAI_ENDPOINT is
# the resource's base URL (e.g. https://<resource-name>.openai.azure.com,
# no trailing slash). AZURE_OPENAI_DEPLOYMENT is the deployment name you
# chose in Azure AI Foundry when deploying a base model — not the base
# model's own name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Error monitoring (25 Aug 2026, go-live hardening) — leave blank to run
# with Sentry unconfigured (errors still log to stdout as before). Get a
# DSN from https://sentry.io after creating a project — see lib/sentry.ts.
SENTRY_DSN=

# Transactional email / SMTP (18 Sep 2026, gap §53) — leave blank to run
# with email unconfigured; POST /auth/forgot-password still creates a real
# reset token (so the flow is testable via a direct API call in dev), it
# just can't deliver it and says so honestly instead of faking a "sent"
# response. Provider-agnostic — point this at any real SMTP relay
# (SendGrid, Postmark, Amazon SES, a Gmail/Workspace relay, etc. all speak
# SMTP). See lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Admin console address for the emailed "Forgot password" link, e.g.
# https://www.example.com/app (no trailing slash). See adminAuth.service.ts.
ADMIN_WEB_URL=
# Coach app address for the link in coach notification emails, e.g.
# https://coach.example.com (no trailing slash). See professionalNotifications.service.ts.
COACH_WEB_URL=
# Encrypts coach payout details (bank account number, IFSC, UPI ID) at rest.
# Exactly 64 hex chars: openssl rand -hex 32. Its own key, not the 2FA key.
# Blank = coaches can't save payout details (503) and reads are masked only.
# See src/modules/professionalPayoutAccount/payoutCrypto.ts.
PAYOUT_DETAILS_ENCRYPTION_KEY=

# Shared rate-limit store (28 Sep 2026, spec §11) — leave blank to run a
# single instance with the in-memory limiter, which is correct there.
# REQUIRED once API_INSTANCE_COUNT is above 1: the API refuses to boot
# with several instances and no shared store, because an in-memory
# limiter behind a load balancer gives an attacker that many times the
# allowance and nothing anywhere reports it. See lib/redis.ts.
REDIS_URL=
API_INSTANCE_COUNT=1

# Local-disk object storage root (spec §11 file storage). Development
# only — the provider reports itself unconfigured regardless, because a
# directory on one machine is not S3. Defaults to ./.storage.
LOCAL_STORAGE_DIR=

# ---- Admin security (FynroX blueprint section 5) ----
# Admin sign-in needs an authenticator-app code. Always on in production.
# On a developer machine it can be switched off with "false"; the test
# suite (NODE_ENV=test) has it off unless set to "true".
ADMIN_MFA_REQUIRED=
# The Super Admin must give a reason for risky changes (saved to the audit
# log). On everywhere except NODE_ENV=test; "true"/"false" overrides.
SUPER_ADMIN_REASON_REQUIRED=
# Maker-checker: approval requests expire after this many days (default 7).
APPROVAL_EXPIRY_DAYS=7
