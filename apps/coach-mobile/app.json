{
  "expo": {
    "name": "Fynrox Coach",
    "slug": "fynrox-coach-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fynroxcoach",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.primefit.coachmobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.primefit.coachmobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fynrox Coach uses your camera to photograph a certification or KYC document.",
          "photosPermission": "Fynrox Coach uses your photo library so you can upload a certification or KYC document.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000"
    }
  }
}
