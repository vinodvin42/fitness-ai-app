{
  "expo": {
    "name": "23PrimeFit Coach",
    "slug": "23primefit-coach-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "primefitcoach",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "com.primefit.coachmobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.primefit.coachmobile",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "23PrimeFit Coach uses your camera to photograph a certification or KYC document.",
          "photosPermission": "23PrimeFit Coach uses your photo library so you can upload a certification or KYC document.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000"
    }
  }
}
