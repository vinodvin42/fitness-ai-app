{
  "name": "@fitness-ai-app/gym-portal",
  "version": "0.0.0",
  "private": true,
  "description": "Gym Partner Lite self-service portal (R2 Wave 5, 21 Sep 2026) — a Gym's own staff/point-of-contact login, a separate identity from AdminUser. Copies apps/admin-web's exact Vite/React/TS stack and AuthProvider/RequireAuth pattern.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@fitness-ai-app/config": "*",
    "@fitness-ai-app/types": "*",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.19.0",
    "i18next": "^23.16.8",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^8.57.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.2",
    "vite": "^8.0.0"
  }
}
